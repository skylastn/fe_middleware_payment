{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "DEV All",
      "request": "launch",
      "type": "dart",
      "program": "${workspaceFolder}/lib/main.dart",
      "flutterMode": "debug",
      "preLaunchTask": "replace-env-development"
    },
    {
      "name": "Prod All",
      "request": "launch",
      "type": "dart",
      "program": "${workspaceFolder}/lib/main.dart",
      "flutterMode": "debug",
      "preLaunchTask": "replace-env-production"
    },
    {
      "name": "DEV (Chrome)",
      "request": "launch",
      "type": "dart",
      "program": "${workspaceFolder}/lib/main.dart",
      "flutterMode": "debug",
      "deviceId": "chrome",
      "preLaunchTask": "replace-env-development",
      "args": [
        "--web-port=10000"
      ]
    },
    {
      "name": "PROD (Chrome)",
      "request": "launch",
      "type": "dart",
      "program": "${workspaceFolder}/lib/main.dart",
      "flutterMode": "debug",
      "deviceId": "chrome",
      "preLaunchTask": "replace-env-production",
      "args": [
        "--web-port=10001"
      ]
    },
    {
      "name": "Web (WASM)",
      "request": "launch",
      "type": "dart",
      "program": "${workspaceFolder}/lib/main.dart",
      "flutterMode": "debug",
      "deviceId": "chrome",
      "preLaunchTask": "replace-env-development-wasm",
      "args": [
        "--wasm"
      ]
    }
  ]
}